<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobfill.helper</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{BUN_ABS_PATH}}</string>
    <string>helper/server.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{REPO_ROOT}}</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>{{HOME}}/Library/Logs/jobfill/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Logs/jobfill/stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:{{BUN_DIR}}:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
